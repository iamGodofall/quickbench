{
  "name": "quickbench",
  "version": "0.1.0",
  "description": "Sovereign, local-first evaluation framework for AI agents with reproducible metrics and caller-controlled report signing.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "quickbench": "./bin/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "demo": "ts-node demo/eval-example.ts",
    "docker": "docker build -t quickbench . && docker run --rm -e QUICKBENCH_SIGNING_KEY=quickbench-demo-local-key quickbench npm run demo",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "csv-parse": "^5.5.6",
    "js-yaml": "^4.1.0",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.7.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "agent-evaluation",
    "benchmark",
    "sovereign-ai",
    "local-ai",
    "mlops",
    "ai-agent",
    "llm-eval"
  ],
  "author": "Themba Enock Mpehle / Enock Labs",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "datasets/**/*",
    "bin/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iamGodofall/quickbench.git"
  },
  "homepage": "https://github.com/iamGodofall/quickbench#readme",
  "bugs": "https://github.com/iamGodofall/quickbench/issues"
}
